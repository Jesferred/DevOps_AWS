---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="Blog · kovalov.in" description="Notes on infrastructure, reliability and the incidents behind them.">
  <section class="py-16">
    <h1 class="text-4xl font-bold tracking-tight">Blog</h1>
    <p class="mt-3 text-muted">Notes on infrastructure, reliability and the incidents behind them.</p>

    <ul class="mt-10 divide-y divide-line">
      {posts.map((post) => (
        <li class="py-6">
          <a href={`/blog/${post.id}/`} class="group block">
            <time class="font-mono text-xs text-muted" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
            <h2 class="mt-1 text-xl font-semibold group-hover:text-accent">{post.data.title}</h2>
            <p class="mt-1 text-muted">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
