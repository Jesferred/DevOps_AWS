---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} · kovalov.in`} description={post.data.description}>
  <article class="mx-auto max-w-3xl py-16">
    <a href="/blog/" class="font-mono text-sm text-accent">← blog</a>
    <h1 class="mt-6 text-4xl font-bold tracking-tight">{post.data.title}</h1>
    <p class="mt-3 font-mono text-xs text-muted">
      <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>
      {post.data.tags.length > 0 && <span> · {post.data.tags.join(' · ')}</span>}
    </p>
    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Base>
