---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const phases = [
  { key: 'dns', label: 'DNS lookup', cls: 'key-1' },
  { key: 'connect', label: 'TCP connect', cls: 'key-2' },
  { key: 'tls', label: 'TLS handshake', cls: 'key-3' },
  { key: 'ttfb', label: 'First byte', cls: 'key-4' },
] as const;

const dora = [
  ['Deployment frequency', 'dora.deploys_per_week', 'perWeek', 'dora.deploy_frequency_level'],
  ['Lead time for changes', 'dora.lead_time_h', 'duration', 'dora.lead_time_level'],
  ['Change failure rate', 'dora.change_failure_rate', 'pct', 'dora.change_failure_rate_level'],
  ['Time to restore', 'dora.time_to_restore_min', 'min', 'dora.time_to_restore_level'],
] as const;
---

<Base title="Status · kovalov.in" description="Live SLOs, error budget, latency, incidents, delivery metrics and cost of kovalov.in.">
  <div class="container-page py-12 sm:py-16" data-status-root>
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">kovalov.in · production</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">Status</h1>
        <p class="mt-3 font-mono text-xs text-muted">
          updated <span data-live="generated_at" data-fmt="ago">—</span> · 30-day data coverage{' '}
          <span data-live="coverage_30d" data-fmt="pct" data-digits="1">—</span> ·
          <a href="/live/status.json" class="link">raw JSON</a>
        </p>
      </div>
      <p class="health-pill h-10 px-4 text-sm" data-health="unknown">
        <span class="status-dot"></span>
        <span data-health-text>Collecting data</span>
      </p>
    </header>

    <!-- SLO ------------------------------------------------------------- -->
    <section class="mt-12" aria-labelledby="slo-h">
      <h2 id="slo-h" class="text-xl font-semibold tracking-tight">Availability SLO</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="stat">
          <p class="stat-label">Objective</p>
          <p class="stat-value" data-live="slo.target" data-fmt="pct" data-digits="1">99.9%</p>
          <p class="stat-meta mt-auto">rolling 30 days</p>
        </article>
        <article class="stat">
          <p class="stat-label">Availability · 30 days</p>
          <p class="stat-value" data-live="availability.30d" data-fmt="pct">—</p>
          <p class="stat-meta mt-auto">7 days <span data-live="availability.7d" data-fmt="pct">—</span></p>
        </article>
        <article class="stat">
          <p class="stat-label">Availability · 24 hours</p>
          <p class="stat-value" data-live="availability.24h" data-fmt="pct">—</p>
          <p class="stat-meta mt-auto">TLS cert expires in <span data-live="tls_cert_days_left">—</span> d</p>
        </article>
        <article class="stat">
          <p class="stat-label">Error budget left</p>
          <p class="stat-value" data-live="error_budget.remaining_min" data-fmt="min">—</p>
          <div class="meter mt-3" data-budget><div class="meter-fill"></div></div>
          <p class="stat-meta mt-2">used <span data-live="error_budget.consumed_min">—</span> of <span data-live="error_budget.total_min" data-fmt="min">—</span></p>
        </article>
      </div>

      <article class="card mt-4 p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-sm text-ink-2">Daily availability, last 30 days</h3>
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-2" aria-label="Legend">
            <li class="flex items-center gap-1.5"><span class="status-dot" data-state="good"></span>Met SLO</li>
            <li class="flex items-center gap-1.5"><span class="status-dot" data-state="warn"></span>Below SLO</li>
            <li class="flex items-center gap-1.5"><span class="status-dot" data-state="bad"></span>Below 99%</li>
            <li class="flex items-center gap-1.5"><span class="status-dot"></span>No data</li>
          </ul>
        </div>
        <div class="mt-5" data-uptime-strip></div>
            <details class="table-view mt-4">
          <summary>Show as table</summary>
          <table class="data-table mt-3">
            <thead><tr><th>Date</th><th>Availability</th><th>Bad minutes</th><th>p95</th></tr></thead>
            <tbody data-daily-rows></tbody>
          </table>
        </details>
      </article>

      <article class="card mt-4 p-5 sm:p-6">
        <h3 class="text-sm text-ink-2">Burn rate</h3>
        <p class="mt-1 max-w-2xl text-sm text-muted">
          How fast the error budget is being spent; 1× spends exactly the whole budget in 30 days. Each alert needs
          both of its windows above the threshold, so it fires fast on real outages and resets quickly once fixed.
        </p>
        <div class="mt-4 overflow-x-auto">
          <table class="data-table min-w-[520px]">
            <thead><tr><th>Window</th><th>Burn rate</th><th>Alert</th><th>Threshold</th></tr></thead>
            <tbody>
              <tr><td>5 minutes</td><td data-live="burn_rate.5m" data-fmt="rate">—</td><td>Fast burn: page</td><td>14.4× on both</td></tr>
              <tr><td>1 hour</td><td data-live="burn_rate.1h" data-fmt="rate">—</td><td>Fast burn: page</td><td>14.4× on both</td></tr>
              <tr><td>30 minutes</td><td data-live="burn_rate.30m" data-fmt="rate">—</td><td>Slow burn: ticket</td><td>6× on both</td></tr>
              <tr><td>6 hours</td><td data-live="burn_rate.6h" data-fmt="rate">—</td><td>Slow burn: ticket</td><td>6× on both</td></tr>
            </tbody>
          </table>
        </div>
      </article>
    </section>

    <!-- Latency --------------------------------------------------------- -->
    <section class="mt-16" aria-labelledby="lat-h">
      <h2 id="lat-h" class="text-xl font-semibold tracking-tight">Latency</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {(['p50', 'p95', 'p99'] as const).map((q) => (
          <article class="stat">
            <p class="stat-label">{q} · 24 hours</p>
            <p class="stat-value" data-live={`latency_ms.24h.${q}`} data-fmt="ms">—</p>
            <p class="stat-meta mt-auto">30 days <span data-live={`latency_ms.30d.${q}`} data-fmt="ms">—</span></p>
          </article>
        ))}
      </div>

      <div class="mt-4 grid gap-4 lg:grid-cols-[1.4fr_1fr]">
        <article class="card p-5 sm:p-6">
          <h3 class="text-sm text-ink-2">Daily p95 latency, ms · last 30 days</h3>
          <div class="mt-4" data-p95-chart></div>
        </article>

        <article class="card p-5 sm:p-6">
          <h3 class="text-sm text-ink-2">Where the time goes · median, 24h</h3>
          <div class="mt-5" data-phase-bar></div>
          <ul class="mt-5 space-y-2.5 text-sm" aria-label="Request phases">
            {phases.map((p) => (
              <li class="flex items-center gap-3">
                <span class={`size-2.5 shrink-0 rounded-sm ${p.cls}`} aria-hidden="true"></span>
                <span class="text-ink-2">{p.label}</span>
                <span class="ml-auto font-medium tabular-nums" data-phase={p.key}>—</span>
              </li>
            ))}
          </ul>
        </article>
      </div>

      <article class="card mt-4 p-5 sm:p-6">
        <h3 class="flex items-center gap-2 text-sm text-ink-2"><Icon name="world" size={16} class="text-muted" />Probe locations</h3>
        <div class="mt-3 overflow-x-auto">
          <table class="data-table min-w-[560px]">
            <thead><tr><th>Region</th><th>Last probe</th><th>Latency</th><th>p95 · 24h</th><th>Success · 24h</th></tr></thead>
            <tbody data-region-rows>
              <tr><td colspan="5" class="text-muted">Waiting for the first probes.</td></tr>
            </tbody>
          </table>
        </div>
      </article>
    </section>

    <!-- Incidents ------------------------------------------------------- -->
    <section class="mt-16" aria-labelledby="inc-h">
      <h2 id="inc-h" class="text-xl font-semibold tracking-tight">Incidents</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <article class="stat">
          <p class="stat-label">Incidents · 30 days</p>
          <p class="stat-value" data-live="incidents.count_30d">—</p>
        </article>
        <article class="stat">
          <p class="stat-label">MTTR</p>
          <p class="stat-value" data-live="incidents.mttr_min" data-fmt="min">—</p>
          <p class="stat-meta mt-auto">mean time to recovery · 90 days</p>
        </article>
        <article class="stat">
          <p class="stat-label">MTBF</p>
          <p class="stat-value" data-live="incidents.mtbf_h" data-fmt="hours">—</p>
          <p class="stat-meta mt-auto">mean time between failures · 30 days</p>
        </article>
      </div>
      <article class="card mt-4 p-5 sm:p-6">
        <h3 class="text-sm text-ink-2">Recent incidents</h3>
        <ul class="mt-3 divide-y divide-line text-sm" data-incident-list>
          <li class="py-2.5 text-muted">No incidents recorded.</li>
        </ul>
      </article>
    </section>

    <!-- Delivery -------------------------------------------------------- -->
    <section class="mt-16" aria-labelledby="dora-h">
      <h2 id="dora-h" class="text-xl font-semibold tracking-tight">Delivery · DORA</h2>
      <p class="mt-1 max-w-2xl text-sm text-muted">
        The four key metrics of software delivery performance over 30 days, with levels from the State of DevOps report.
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {dora.map(([label, path, f, level]) => (
          <article class="stat">
            <p class="stat-label">{label}</p>
            <p class="stat-value" data-live={path} data-fmt={f} data-digits={f === 'pct' ? '1' : undefined}>—</p>
            <p class="mt-auto pt-2"><span class="level" data-level={level}>—</span></p>
          </article>
        ))}
      </div>
      <article class="card mt-4 p-5 sm:p-6">
        <h3 class="text-sm text-ink-2">Recent deployments</h3>
        <div class="mt-3 overflow-x-auto">
          <table class="data-table min-w-[520px]">
            <thead><tr><th>When</th><th>Kind</th><th>Commit</th><th>Result</th><th>Lead time</th></tr></thead>
            <tbody data-deploy-rows>
              <tr><td colspan="5" class="text-muted">No deployments recorded yet.</td></tr>
            </tbody>
          </table>
        </div>
      </article>
    </section>

    <!-- Cost ------------------------------------------------------------ -->
    <section class="mt-16" aria-labelledby="cost-h">
      <h2 id="cost-h" class="text-xl font-semibold tracking-tight">Cost</h2>
      <div class="mt-4 grid gap-4 lg:grid-cols-[1fr_2fr]">
        <div class="grid gap-4">
          <article class="stat">
            <p class="stat-label">Month to date</p>
            <p class="stat-value" data-live="cost.month_to_date" data-fmt="usd">—</p>
            <p class="stat-meta">updated <span data-live="cost.updated_at" data-fmt="ago">—</span></p>
          </article>
          <article class="stat">
            <p class="stat-label">Forecast · full month</p>
            <p class="stat-value" data-live="cost.forecast_month" data-fmt="usd">—</p>
            <p class="stat-meta">AWS Cost Explorer · usage before credits</p>
          </article>
        </div>
        <article class="card p-5 sm:p-6">
          <h3 class="text-sm text-ink-2">By service, this month</h3>
          <ul class="mt-4 space-y-3 text-sm" data-cost-rows>
            <li class="text-muted">Cost data refreshes weekly.</li>
          </ul>
        </article>
      </div>
    </section>

    <!-- Methodology ----------------------------------------------------- -->
    <section class="prose mt-16">
      <h2>Methodology</h2>
      <ul>
        <li>
          <strong>SLI.</strong> Synthetic HTTPS probes run every minute from Frankfurt, N. Virginia and Singapore. Each
          one does DNS, TCP and TLS from scratch and passes only on <code>HTTP 200</code> with a valid certificate.
        </li>
        <li>
          <strong>Good and bad minutes.</strong> A minute counts when at least two regions reported. It is bad when most
          of them failed, so one flaky probe location cannot spend the budget on its own.
        </li>
        <li>
          <strong>SLO.</strong> 99.9% of evaluated minutes over a rolling 30 days. The remaining 0.1% is the error
          budget: 43.2 minutes.
        </li>
        <li>
          <strong>Alerting.</strong> Multi-window, multi-burn-rate alerts from the Google SRE Workbook, plus a watchdog
          that fires if probes stop reporting.
        </li>
        <li>
          <strong>Incidents</strong> start at the first bad minute and end after two consecutive good ones. MTTR is their
          mean duration; MTBF is uptime divided by the number of incidents.
        </li>
        <li>
          <strong>Percentiles.</strong> 24-hour values are exact. 30-day values are interpolated from per-day latency
          histograms, the way Prometheus <code>histogram_quantile</code> works.
        </li>
        <li>
          <strong>DORA.</strong> Every production deploy and Terraform apply records an event from CI. A change counts
          as failed if its deploy failed or an SLO incident started within an hour of it.
        </li>
        <li>
          <strong>Cost</strong> is read weekly from AWS Cost Explorer; each API call costs $0.01, so it is never
          queried per page view.
        </li>
      </ul>
    </section>
  </div>
</Base>

<script>
  import { budgetMeter, dayState, lineChart, segmentedBar, uptimeStrip } from '../scripts/charts';
  import { el, fill, fillStates, fmt, health, loadStatus, setHealth, type Status } from '../scripts/live';

  const root = document.querySelector<HTMLElement>('[data-status-root]')!;
  const q = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

  function row(cells: (string | Node)[]): HTMLTableRowElement {
    const tr = el('tr');
    for (const c of cells) {
      const td = el('td');
      td.append(c);
      tr.append(td);
    }
    return tr;
  }

  function withDot(state: 'good' | 'warn' | 'bad' | 'none', text: string): HTMLElement {
    const span = el('span', 'inline-flex items-center gap-2');
    const dot = el('span', 'status-dot');
    if (state !== 'none') dot.dataset.state = state;
    span.append(dot, text);
    return span;
  }

  function render(s: Status) {
    fill(root, s);
    fillStates(root, s);
    budgetMeter(q('[data-budget]'), s.error_budget.remaining_ratio);

    // Daily table view (newest first) backing the uptime strip.
    const daily = [...s.daily].reverse();
    if (daily.length) {
      q('[data-daily-rows]').replaceChildren(
        ...daily.map((d) =>
          row([
            d.date,
            withDot(dayState(d.availability, s.slo.target), fmt.pct(d.availability)),
            String(d.bad_min),
            fmt.ms(d.p95_ms),
          ]),
        ),
      );
    }

    // p95 line over the last 30 calendar days, gaps where there is no data.
    const byDate = new Map(s.daily.map((d) => [d.date, d]));
    const points = Array.from({ length: 30 }, (_, i) => {
      const date = new Date(Date.now() - (29 - i) * 86400000).toISOString().slice(0, 10);
      return { label: date.slice(5), value: byDate.get(date)?.p95_ms ?? null };
    });
    lineChart(q('[data-p95-chart]'), points, { unit: 'ms', name: 'Daily p95 latency' });

    // Phases are cumulative timestamps from request start; chart the deltas.
    const keys = ['dns', 'connect', 'tls', 'ttfb'] as const;
    const marks = keys.map((k) => s.phases_ms_24h[k]);
    if (marks.every((m) => m !== null)) {
      const deltas = marks.map((m, i) => Math.round((m! - (i ? marks[i - 1]! : 0)) * 10) / 10);
      const labels = ['DNS lookup', 'TCP connect', 'TLS handshake', 'First byte'];
      segmentedBar(
        q('[data-phase-bar]'),
        deltas.map((v, i) => ({ label: labels[i], value: v, cls: `seg-${i + 1}` })),
        'ms',
      );
      keys.forEach((k, i) => (q(`[data-phase="${k}"]`).textContent = `${deltas[i]} ms`));
    }

    if (s.regions.length) {
      q('[data-region-rows]').replaceChildren(
        ...s.regions.map((r) =>
          row([
            r.region,
            withDot(r.last_ok ? 'good' : 'bad', `${r.last_ok ? 'ok' : 'failed'} · ${fmt.ago(r.last_at)}`),
            fmt.ms(r.last_ms),
            fmt.ms(r.p95_24h_ms),
            fmt.pct(r.availability_24h, 2),
          ]),
        ),
      );
    }

    if (s.incidents.recent.length) {
      q('[data-incident-list]').replaceChildren(
        ...s.incidents.recent.map((i) => {
          const li = el('li', 'flex flex-wrap justify-between gap-2 py-2.5');
          li.append(
            withDot(i.end ? 'warn' : 'bad', fmt.utc(i.start)),
            el('span', 'font-mono text-muted', i.end ? `resolved in ${fmt.min(i.duration_min)}` : 'ongoing'),
          );
          return li;
        }),
      );
    }

    if (s.dora?.recent.length) {
      q('[data-deploy-rows]').replaceChildren(
        ...s.dora.recent.map((d) => {
          const sha = el('a', 'link font-mono', d.sha);
          if (d.run_url?.startsWith('https://github.com/')) sha.href = d.run_url;
          return row([fmt.ago(d.at), d.kind, sha, withDot(d.status === 'success' ? 'good' : 'bad', d.status), fmt.duration(d.lead_time_h)]);
        }),
      );
    }

    const services = s.cost?.by_service ?? [];
    if (services.length) {
      const max = Math.max(...services.map((x) => x.amount), 0.01);
      q('[data-cost-rows]').replaceChildren(
        ...services.map((svc) => {
          const li = el('li', 'grid grid-cols-[minmax(0,10rem)_1fr_auto] items-center gap-3');
          const bar = el('div', 'hbar');
          bar.style.setProperty('--w', `${((svc.amount / max) * 100).toFixed(1)}%`);
          const track = el('div');
          track.append(bar);
          li.append(el('span', 'truncate text-ink-2', svc.service.replace(/^(Amazon|AWS) /, '')), track, el('span', 'font-medium tabular-nums', fmt.usd(svc.amount)));
          return li;
        }),
      );
    }
  }

  loadStatus().then((s) => {
    uptimeStrip(q('[data-uptime-strip]'), s?.daily ?? [], s?.slo.target ?? 0.999);
    if (s) render(s);
    setHealth(root, health(s));
  });
</script>
