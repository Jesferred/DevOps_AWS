---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found · kovalov.in" description="Page not found">
  <section class="container-page py-24 sm:py-32">
    <p class="eyebrow">HTTP 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Nothing at this path.</h1>
    <p class="mt-4 max-w-lg text-ink-2">The page may have moved. Don't worry, a 404 doesn't count against the error budget.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary"><Icon name="arrow-left" size={18} />Home</a>
      <a href="/status/" class="btn btn-ghost"><Icon name="activity" size={18} />Status</a>
    </div>
  </section>
</Base>
