---
import Base from '../layouts/Base.astro';
---

<Base title="404 · kovalov.in" description="Page not found">
  <section class="py-24">
    <p class="font-mono text-sm text-accent">HTTP 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Nothing here.</h1>
    <p class="mt-4 text-muted">The page may have moved. The error budget is fine, though.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-accent px-5 py-2.5 font-medium text-bg">Back home</a>
  </section>
</Base>
