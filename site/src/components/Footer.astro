---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {profile.name} · {profile.location}</p>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <span>Astro · AWS Amplify · Terraform</span>
      <a href="/status/" class="hover:text-ink">Status</a>
      <a href="https://github.com/Jesferred/DevOps_AWS" class="inline-flex items-center gap-1 hover:text-ink">
        Source & IaC <Icon name="arrow-up-right" size={14} />
      </a>
    </div>
  </div>
</footer>
