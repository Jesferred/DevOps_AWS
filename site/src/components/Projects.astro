---
import Icon from './Icon.astro';
import DiagramKovalovIn from './DiagramKovalovIn.astro';
import { projects } from '../data/projects';
---

<section id="projects" class="section container-page">
  <p class="eyebrow">Projects</p>
  <h2 class="section-title">Selected work</h2>

  <div class="mt-8 space-y-4">
    {projects.map((p) => (
      <article class="card p-6 sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="max-w-3xl">
            <h3 class="text-xl font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-2 text-pretty text-ink-2">{p.summary}</p>
          </div>
          {p.repo && (
            <a href={p.repo} class="btn btn-ghost shrink-0">
              <Icon name="brand-github" size={18} />
              Source
            </a>
          )}
        </div>

        <ul class="mt-6 grid gap-x-8 gap-y-3 text-sm text-ink sm:grid-cols-2">
          {p.highlights.map((h) => (
            <li class="flex gap-3">
              <span class="mt-0.5 text-accent"><Icon name="check" size={16} /></span>
              <span>{h}</span>
            </li>
          ))}
        </ul>

        <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Stack">
          {p.stack.map((s) => <li class="chip">{s}</li>)}
        </ul>

        {p.diagram === 'kovalov-in' && <DiagramKovalovIn />}
      </article>
    ))}
  </div>
</section>
