---
import { projects } from '../data/projects';
import DiagramKovalovIn from './DiagramKovalovIn.astro';
---

<section id="projects" class="scroll-mt-20 py-12">
  <h2 class="text-2xl font-semibold tracking-tight">Projects</h2>

  <div class="mt-6 space-y-6">
    {projects.map((p) => (
      <article class="rounded-xl border border-line bg-surface p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-xl font-semibold">{p.title}</h3>
          {p.repo && <a href={p.repo} class="font-mono text-xs text-accent underline underline-offset-4">source</a>}
        </div>
        <p class="mt-2 text-muted">{p.summary}</p>

        <ul class="mt-4 list-disc space-y-1 pl-5 text-sm">
          {p.highlights.map((h) => <li>{h}</li>)}
        </ul>

        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack">
          {p.stack.map((s) => (
            <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-muted">{s}</li>
          ))}
        </ul>

        {p.diagram === 'kovalov-in' && <DiagramKovalovIn />}
      </article>
    ))}
  </div>
</section>
