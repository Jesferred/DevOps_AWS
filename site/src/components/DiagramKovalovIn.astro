---
// Architecture of this site. Plain inline SVG: no JS, themed via CSS variables.
const box = 'fill-surface stroke-line';
const label = 'fill-fg text-[13px] font-medium';
const sub = 'fill-muted font-mono text-[10px]';
const edge = 'stroke-muted';
---

<figure class="mt-6 overflow-x-auto rounded-xl border border-line bg-bg p-4">
  <svg viewBox="0 0 760 300" class="mx-auto block w-full min-w-[640px]" role="img" aria-labelledby="dia-title dia-desc">
    <title id="dia-title">kovalov.in architecture</title>
    <desc id="dia-desc">
      Visitors resolve the domain in Route 53 and reach CloudFront, which validates TLS with an ACM certificate,
      runs a viewer-request function, adds security headers and reads from a private S3 bucket through Origin Access Control.
      GitHub Actions assumes IAM roles via OIDC to run Terraform and upload the site build.
    </desc>
    <defs>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0L10 5L0 10z" class="fill-muted" />
      </marker>
    </defs>

    <g stroke-width="1.5" fill="none" marker-end="url(#arrow)">
      <path d="M110 70H170" class={edge} />
      <path d="M290 70H350" class={edge} />
      <path d="M530 70H590" class={edge} />
      <path d="M110 230H170" class={edge} />
      <path d="M290 230H350" class={edge} />
      <path d="M470 200L630 104" class={edge} stroke-dasharray="4 4" />
      <path d="M440 200L440 104" class={edge} stroke-dasharray="4 4" />
    </g>

    <g stroke-width="1.5">
      <rect x="10" y="40" width="100" height="60" rx="10" class={box} />
      <text x="60" y="68" text-anchor="middle" class={label}>Visitor</text>
      <text x="60" y="85" text-anchor="middle" class={sub}>HTTP/3 · IPv6</text>

      <rect x="170" y="40" width="120" height="60" rx="10" class={box} />
      <text x="230" y="68" text-anchor="middle" class={label}>Route 53</text>
      <text x="230" y="85" text-anchor="middle" class={sub}>alias A/AAAA · CAA</text>

      <rect x="350" y="20" width="180" height="84" rx="10" class="fill-surface stroke-accent" />
      <text x="440" y="48" text-anchor="middle" class={label}>CloudFront</text>
      <text x="440" y="65" text-anchor="middle" class={sub}>ACM TLS 1.2+ · CF Function</text>
      <text x="440" y="80" text-anchor="middle" class={sub}>HSTS · CSP · OAC</text>

      <rect x="590" y="40" width="150" height="60" rx="10" class={box} />
      <text x="665" y="68" text-anchor="middle" class={label}>S3 (private)</text>
      <text x="665" y="85" text-anchor="middle" class={sub}>versioned · SSE</text>

      <rect x="10" y="200" width="100" height="60" rx="10" class={box} />
      <text x="60" y="228" text-anchor="middle" class={label}>git push</text>
      <text x="60" y="245" text-anchor="middle" class={sub}>PR → main</text>

      <rect x="170" y="200" width="120" height="60" rx="10" class={box} />
      <text x="230" y="228" text-anchor="middle" class={label}>GitHub Actions</text>
      <text x="230" y="245" text-anchor="middle" class={sub}>plan · approve</text>

      <rect x="350" y="200" width="180" height="60" rx="10" class={box} />
      <text x="440" y="228" text-anchor="middle" class={label}>IAM via OIDC</text>
      <text x="440" y="245" text-anchor="middle" class={sub}>1h STS · no keys</text>
    </g>

    <text x="560" y="170" class={sub}>terraform apply · s3 sync</text>
    <text x="450" y="160" class={sub}>invalidate</text>
  </svg>
  <figcaption class="mt-3 text-center text-xs text-muted">Solid lines: request path. Dashed: delivery path.</figcaption>
</figure>
