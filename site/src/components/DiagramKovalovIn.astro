---
// Architecture of this site as three flows. Plain HTML, so it reflows instead of
// scaling: a row with → arrows on wide screens, a column with ↓ arrows on phones.
import Icon, { type IconName } from './Icon.astro';

interface Node {
  title: string;
  detail: string;
  icon: IconName;
  accent?: boolean;
}

const lanes: { name: string; nodes: Node[] }[] = [
  {
    name: 'Request path',
    nodes: [
      { title: 'Visitor', detail: 'HTTP/2 · IPv6', icon: 'users' },
      { title: 'Route 53', detail: 'alias A/AAAA · CAA', icon: 'world' },
      { title: 'Amplify Hosting', detail: 'TLS 1.3 · own ACM cert · HSTS · CSP', icon: 'lock', accent: true },
      { title: 'S3', detail: 'versioned releases · live JSON', icon: 'database' },
    ],
  },
  {
    name: 'Delivery',
    nodes: [
      { title: 'Pull request', detail: 'plan · security scan · cost diff', icon: 'git-merge' },
      { title: 'GitHub Actions', detail: 'manual approval', icon: 'rocket' },
      { title: 'IAM via OIDC', detail: '1h STS · no stored keys', icon: 'shield-check' },
      { title: 'AWS', detail: 'terraform apply · release.zip', icon: 'certificate', accent: true },
    ],
  },
  {
    name: 'Observability',
    nodes: [
      { title: 'Lambda probes', detail: '3 regions · every minute', icon: 'activity' },
      { title: 'DynamoDB', detail: 'probe results · deploy events', icon: 'database' },
      { title: 'SLO aggregator', detail: 'budget · burn rate · DORA', icon: 'gauge' },
      { title: 'status.json', detail: 'read by this page', icon: 'clock', accent: true },
    ],
  },
];
---

<figure class="mt-6 rounded-xl border border-line bg-page p-4 sm:p-6" aria-labelledby="dia-caption">
  <div class="space-y-6">
    {lanes.map((lane) => (
      <section aria-label={lane.name}>
        <h4 class="eyebrow mb-3">{lane.name}</h4>
        <ol class="flex flex-col items-stretch gap-1.5 lg:flex-row lg:gap-2">
          {lane.nodes.map((n, i) => (
            <>
              {i > 0 && (
                <li aria-hidden="true" class="flex items-center justify-center text-muted lg:shrink-0">
                  <Icon name="arrow-down" size={16} class="lg:hidden" />
                  <Icon name="arrow-right" size={16} class="hidden lg:block" />
                </li>
              )}
              <li
                class:list={[
                  'flex min-w-0 flex-1 items-center gap-3 rounded-xl border bg-raised px-3.5 py-3',
                  n.accent ? 'border-accent' : 'border-line-strong',
                ]}
              >
                <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface text-ink-2 ring-1 ring-line">
                  <Icon name={n.icon} size={16} />
                </span>
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-ink">{n.title}</span>
                  <span class="block font-mono text-[11px] leading-4 text-muted">{n.detail}</span>
                </span>
              </li>
            </>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <figcaption id="dia-caption" class="mt-5 text-xs text-muted">
    How kovalov.in is served, shipped and measured. Everything shown is defined in the repository's Terraform.
  </figcaption>
</figure>
