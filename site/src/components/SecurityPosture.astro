---
// Grades come from weekly third-party scans run by the monitoring aggregator
// (SSL Labs, Mozilla HTTP Observatory, hstspreload.org, DNS over HTTPS).
// Each tile links to the public report so anyone can verify it.
import Icon from './Icon.astro';

const controls = [
  { text: 'TLS 1.3 and 1.2 only', check: 'security.ssl_labs.protocols' },
  { text: 'Strict CSP, no inline code', state: 'pass' },
  { text: 'Own ACM certificate, ECDSA P-256', state: 'pass' },
  { text: 'CAA: only Amazon may issue certificates', check: 'security.caa' },
  { text: 'DMARC policy enforced', check: 'security.dmarc_policy', pass: 'quarantine,reject' },
  { text: 'DNSSEC signed zone', check: 'security.dnssec' },
  { text: 'Keyless CI/CD (GitHub OIDC)', state: 'pass' },
  { text: 'IaC, dependency and secret scanning on every PR', state: 'pass' },
];
---

<section id="security" class="section container-page" data-security-root>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Security posture</p>
      <h2 class="section-title">Graded by third parties, every week</h2>
      <p class="section-lede">
        Scores come from public scanners, not a self-assessment. Each card links to the live report.
      </p>
    </div>
    <p class="font-mono text-xs text-muted">last scan <span data-live="security.checked_at" data-fmt="ago">—</span></p>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-3">
    <a class="card group flex flex-col p-6 hover:border-line-strong" href="https://www.ssllabs.com/ssltest/analyze.html?d=kovalov.in" data-href="security.ssl_labs.report_url">
      <span class="flex items-center justify-between text-sm text-ink-2">
        <span class="flex items-center gap-2"><Icon name="lock" size={16} class="text-muted" />Qualys SSL Labs</span>
        <Icon name="arrow-up-right" size={16} class="text-muted group-hover:text-ink" />
      </span>
      <span class="mt-6 text-6xl font-semibold tracking-tight" data-live="security.ssl_labs.grade" data-fmt="text">—</span>
      <span class="mt-4 text-sm text-ink-2">TLS configuration, certificate chain, protocol support</span>
    </a>

    <a class="card group flex flex-col p-6 hover:border-line-strong" href="https://developer.mozilla.org/en-US/observatory/analyze?host=kovalov.in" data-href="security.observatory.report_url">
      <span class="flex items-center justify-between text-sm text-ink-2">
        <span class="flex items-center gap-2"><Icon name="shield-check" size={16} class="text-muted" />Mozilla Observatory</span>
        <Icon name="arrow-up-right" size={16} class="text-muted group-hover:text-ink" />
      </span>
      <span class="mt-6 text-6xl font-semibold tracking-tight" data-live="security.observatory.grade" data-fmt="text">—</span>
      <span class="mt-4 text-sm text-ink-2">
        HTTP security headers · score <span data-live="security.observatory.score">—</span> ·{' '}
        <span data-live="security.observatory.tests_passed">—</span>/<span data-live="security.observatory.tests_total">—</span> tests
      </span>
    </a>

    <a class="card group flex flex-col p-6 hover:border-line-strong" href="https://hstspreload.org/?domain=kovalov.in">
      <span class="flex items-center justify-between text-sm text-ink-2">
        <span class="flex items-center gap-2"><Icon name="world" size={16} class="text-muted" />HSTS preload list</span>
        <Icon name="arrow-up-right" size={16} class="text-muted group-hover:text-ink" />
      </span>
      <span class="mt-6 text-4xl font-semibold tracking-tight capitalize" data-live="security.hsts_preload" data-fmt="text">—</span>
      <span class="mt-4 text-sm text-ink-2">Browsers refuse plain HTTP before the first request</span>
    </a>
  </div>

  <ul class="mt-4 grid gap-2 sm:grid-cols-2" aria-label="Security controls">
    {controls.map((c) => (
      <li class="check" data-check={c.check} data-pass={c.pass} data-state={c.state ?? 'unknown'}>
        <span class="check-icon" aria-hidden="true"></span>
        <span>{c.text}</span>
        <span class="check-state" data-check-text></span>
      </li>
    ))}
  </ul>
</section>

<script>
  import { fill, fillStates, loadStatus } from '../scripts/live';

  const root = document.querySelector<HTMLElement>('[data-security-root]');

  // Icon and word for each state: status is never carried by color alone.
  function label(el: HTMLElement) {
    const state = el.dataset.state ?? 'unknown';
    el.querySelector('.check-icon')!.textContent = state === 'pass' ? '✓' : state === 'fail' ? '!' : '';
    el.querySelector('[data-check-text]')!.textContent = state === 'pass' ? 'pass' : state === 'fail' ? 'not yet' : 'pending';
  }

  if (root) {
    root.querySelectorAll<HTMLElement>('.check').forEach(label);
    loadStatus().then((s) => {
      if (!s?.security) return;
      fill(root, s);
      fillStates(root, s);
      // "TLS 1.3 and 1.2 only": nothing older among the offered protocols.
      const protocols = s.security.ssl_labs?.protocols;
      const tls = root.querySelector<HTMLElement>('[data-check="security.ssl_labs.protocols"]');
      if (tls && protocols) tls.dataset.state = protocols.some((p) => /SSL|TLS 1\.[01]$/.test(p)) ? 'fail' : 'pass';
      root.querySelectorAll<HTMLElement>('.check').forEach(label);
    });
  }
</script>
