---
import { profile } from '../data/profile';
---

<section class="py-16 sm:py-24">
  <p class="font-mono text-sm text-accent">$ whoami</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">{profile.name}</h1>
  <p class="mt-2 text-xl text-muted sm:text-2xl">{profile.role}</p>
  <p class="mt-6 max-w-2xl text-lg leading-8">{profile.headline}</p>

  <ul class="mt-8 flex flex-wrap gap-2" aria-label="Skills">
    {profile.skills.map((s) => (
      <li class="rounded-full border border-line bg-surface px-3 py-1 font-mono text-xs text-muted">{s}</li>
    ))}
  </ul>

  <div class="mt-10 flex flex-wrap gap-3">
    <a href="#projects" class="rounded-lg bg-accent px-5 py-2.5 font-medium text-bg hover:opacity-90">See the work</a>
    <a href={profile.links.github} class="rounded-lg border border-line px-5 py-2.5 font-medium hover:bg-surface">GitHub</a>
  </div>
</section>
