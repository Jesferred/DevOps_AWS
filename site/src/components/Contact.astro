---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<section id="contact" class="section container-page">
  <div class="card flex flex-col gap-8 p-6 sm:p-10 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-xl">
      <p class="eyebrow">Contact</p>
      <h2 class="section-title">Let's talk infrastructure</h2>
      <p class="section-lede">Open to DevOps and SRE roles and to infrastructure projects. The quickest way to reach me:</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={profile.links.linkedin} class="btn btn-primary h-12 px-5" rel="me">
        <Icon name="brand-linkedin" />
        LinkedIn
      </a>
      <a href={profile.links.github} class="btn btn-ghost h-12 px-5" rel="me">
        <Icon name="brand-github" />
        GitHub
      </a>
      {profile.links.email && (
        <a href={`mailto:${profile.links.email}`} class="btn btn-ghost h-12 px-5">
          <Icon name="mail" />
          Email
        </a>
      )}
    </div>
  </div>
</section>
